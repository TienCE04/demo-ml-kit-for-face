<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="8dp"
    android:paddingEnd="22dp">

    <EditText
        android:id="@+id/etStudentId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mã sinh viên"
        android:inputType="text"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Họ và tên"
        android:inputType="textCapWords"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Chọn 3 ảnh theo thứ tự: chính diện, nghiêng trái, nghiêng phải. Có thể chọn thêm 1 ảnh. Ảnh chỉ xử lý tạm để tạo embedding trên thiết bị."
        android:textColor="#68757C"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cbConsent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tôi đồng ý dùng embedding khuôn mặt cho điểm danh (v1)"
        android:textSize="13sp" />
</LinearLayout>
