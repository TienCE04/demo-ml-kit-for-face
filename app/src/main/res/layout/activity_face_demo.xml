<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FACE AUTH · MODEL INPUT / OUTPUT"
            android:textColor="#147D70"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Embedding &amp; xác thực"
            android:textColor="#15232B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Luồng thử độc lập: 3–4 ảnh đăng ký → các embedding mẫu → 1 ảnh kiểm tra → cosine và quyết định MATCH / NO MATCH. Không chạy BLE và không ghi điểm danh."
            android:textColor="#56636B"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="01 · TẠO HỒ SƠ EMBEDDING"
                    android:textColor="#15232B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Mã sinh viên"
                    android:inputType="text"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Họ và tên"
                    android:inputType="textCapWords"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chọn 3–4 ảnh của cùng một người. Cần đủ chính diện và hai hướng trái/phải theo yaw ML Kit. Mỗi ảnh phải có đúng một khuôn mặt, đủ lớn và rõ."
                    android:textColor="#68757C"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/cbConsent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đồng ý tạo và lưu embedding để thử xác thực (demo)"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickEnrollmentPhotos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chọn 3–4 ảnh đăng ký" />

                <TextView
                    android:id="@+id/tvEnrollmentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#EFF5F4"
                    android:padding="10dp"
                    android:text="Chưa chọn ảnh đăng ký."
                    android:textColor="#23594F"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateEmbedding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tạo embedding &amp; lưu hồ sơ" />

                <TextView
                    android:id="@+id/tvEnrollmentOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#F4F6F8"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:text="Đầu ra model sẽ hiển thị tại đây."
                    android:textColor="#29383F"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="02 · XÁC THỰC ẢNH KIỂM TRA"
                    android:textColor="#15232B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chọn một ảnh mới. App tạo embedding 192-D, so cosine với từng mẫu của mọi hồ sơ; MATCH cần đạt cả ngưỡng cosine đã cấu hình và margin phân biệt người đứng đầu."
                    android:textColor="#68757C"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickProbePhoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chọn ảnh kiểm tra &amp; chạy xác thực" />

                <TextView
                    android:id="@+id/tvAuthOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#EFF5F4"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:text="Chưa có ảnh xác thực."
                    android:textColor="#23594F"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
